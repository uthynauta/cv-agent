# Required only for live POST /v1/responses calls. Keep empty for local health checks.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
GROUNDING_MODE=inference
# Options: lexical, llm_rerank.
RETRIEVAL_MODE=lexical
# Used when RETRIEVAL_MODE=llm_rerank. Keep empty to reuse OPENAI_MODEL.
RERANK_MODEL=
# Lexical over-retrieval size. With CONTEXT_MODE=page, generated wiki pages not
# found lexically are also offered to the reranker as fallback candidates.
RERANK_TOP_K=20
ANSWER_TOP_K=5
# Options: page, excerpt. page sends selected full wiki pages within MAX_CONTEXT_CHARS.
CONTEXT_MODE=page
MAX_CONTEXT_CHARS=12000
INGESTION_MODE=openai
AGENT_API_KEY=
# Required to enable POST /admin/ingest. Empty disables the endpoint.
ADMIN_API_KEY=
ADMIN_UI_PASSWORD=
ADMIN_UI_SESSION_SECRET=
ADMIN_UI_SESSION_MAX_AGE_SECONDS=43200
ADMIN_UPLOAD_MAX_BYTES=10485760
GITHUB_TOKEN=
GITHUB_REPOSITORY=uthynauta/cv-agent
GITHUB_BASE_BRANCH=main
GITHUB_COMMIT_AUTHOR_NAME=Banorte Agent Admin
GITHUB_COMMIT_AUTHOR_EMAIL=
AGENT_MODEL_NAME=banorte-cv-agent
AGENT_PUBLIC_URL=https://banorte-cv-agent.onrender.com
WIKI_DIR=wiki
OTEL_ENABLED=false
OTEL_SERVICE_NAME=banorte-cv-agent
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4317
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=local
